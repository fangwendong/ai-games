# IB Gateway defaults on this host: host=127.0.0.1, port=4001.
# If you are using TWS paper mode instead, override IBKR_PORT manually.
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=42
IBKR_READONLY=true
IBKR_ACCOUNT=

# Keep paper unless you have deliberately reviewed live trading controls.
IBKR_TRADING_MODE=paper
IBKR_ALLOW_LIVE_TRADING=false
IBKR_DRY_RUN=true

# Comma-separated symbols the bot is allowed to trade.
IBKR_ALLOWED_SYMBOLS=AAPL,MSFT,SPY,SOXL,SOXS,TQQQ,TECL
IBKR_VWAP_SYMBOLS=SOXL,TQQQ,TECL
IBKR_MAX_ORDER_NOTIONAL=1000
IBKR_MARKET_DATA_TYPE=delayed
IBKR_LIVE_BAR_MAX_AGE_SECONDS=420
IBKR_MAX_DAILY_ENTRIES=1
IBKR_STATE_DIR=.ibkr_bot_state/semiconductor_rotation_intraday
IBKR_ENTRY_ORDER_PRICE_OFFSET_BPS=5
IBKR_ENTRY_ORDER_FILL_WAIT_SECONDS=20
IBKR_FLATTEN_BEFORE_CLOSE_MINUTES=10
# Safe template default. The live checkout currently overrides this to 120.
IBKR_MAX_RISK_PER_TRADE=10
IBKR_ATR_WINDOW=14
IBKR_ATR_STOP_MULTIPLE=2
IBKR_HISTORICAL_REQUEST_PAUSE_SECONDS=0.25
# Disabled until same-source ARCA history and frozen-v2 validation pass.
IBKR_ARCA_FALLBACK_ENABLED=false
