# IB Gateway defaults on this host: host=127.0.0.1, port=4001.
# If you are using TWS paper mode instead, override IBKR_PORT manually.
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=42
IBKR_READONLY=true
IBKR_ACCOUNT=

# Keep paper unless you have deliberately reviewed live trading controls.
IBKR_TRADING_MODE=paper
IBKR_ALLOW_LIVE_TRADING=false
IBKR_DRY_RUN=true

# Comma-separated symbols the bot is allowed to trade.
IBKR_ALLOWED_SYMBOLS=AAPL,MSFT,SPY
IBKR_VWAP_SYMBOLS=SOXL,TQQQ,TECL
IBKR_MAX_ORDER_NOTIONAL=1000
IBKR_MARKET_DATA_TYPE=delayed
IBKR_LIVE_BAR_MAX_AGE_SECONDS=420
